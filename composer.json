{
    "name": "packstub/filament-themes",
    "description": "Themes for Filament panels: designed looks with a per-panel default, an open registry any package can add a theme to, and a picker that lets each user choose their own.",
    "keywords": [
        "packstub",
        "laravel",
        "filament",
        "filament-plugin",
        "filament-v5",
        "filament-theme",
        "filament-themes",
        "theme",
        "themes",
        "theme-switcher",
        "dark-mode",
        "ui"
    ],
    "homepage": "https://github.com/packstub/filament-themes",
    "support": {
        "issues": "https://github.com/packstub/filament-themes/issues",
        "source": "https://github.com/packstub/filament-themes",
        "docs": "https://packstub.dev/docs/filament-themes"
    },
    "license": "MIT",
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/icaliman"
        }
    ],
    "authors": [
        {
            "name": "Ion Caliman",
            "email": "icaliman92@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Packstub",
            "email": "support@packstub.dev",
            "homepage": "https://packstub.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-livewire": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Packstub\\Themes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packstub\\Themes\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:filter": "pest --filter",
        "lint": "vendor/bin/pint",
        "lint:test": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Packstub\\Themes\\ThemesServiceProvider"
            ],
            "aliases": {
                "Themes": "Packstub\\Themes\\Facades\\Themes"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
